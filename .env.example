# Environment Configuration
# Copy this file to .env and fill in your values

# Server (Render automatically sets PORT in production)
PORT=3000
NODE_ENV=development

# Database (Aiven MySQL shared defaultdb)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_NAME=defaultdb
DB_SSL=true

# Aiven TLS Certificate (strict verification enforced):
# Option A (Local dev or Render Secret File): Path to CA file
DB_CA_PATH=certs/aiven-ca.pem
# Option B (Render Environment Variable): Raw CA certificate text or multiline string
# DB_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Upload limits
MAX_FILE_SIZE_MB=5

# Rate limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=10

# CORS - Comma-separated allowed origins (add your exact production Vercel origin)
# e.g., http://localhost:3000,https://resumefit-ai.vercel.app,https://resume-fit-ai.vercel.app
ALLOWED_ORIGINS=http://localhost:3000

# Authentication (JWT)
JWT_SECRET=replace_with_a_secure_secret_key
JWT_EXPIRES_IN=7d
